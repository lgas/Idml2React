{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "cleanupPeriodDays": 7,
  "effortLevel": "low",
  "autoUpdatesChannel": "stable",

  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [],
    "ask": [
      "Edit",
      "Write",
      "MultiEdit",
      "Bash(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Task(*)",
      "TodoWrite"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Bash(chmod *)"
    ]
  },

  "attribution": {
    "commit": "",
    "pr": ""
  },

  "disableAllHooks": true,

  "enableAllProjectMcpServers": false
}