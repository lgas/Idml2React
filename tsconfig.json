{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
   /*  "jsx": "react-jsx",         
    "jsxImportSource": "react", */
    "paths": {
      "@/*": ["./src/*"],
      "@config/*": ["./src/config/*"],
      "@parsers/*": ["./src/parsers/*"],
      /* "@mappers/*": ["./src/mappers/*"],
      "@components/*": ["./src/components/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@styles/*": ["./src/styles/*"], */
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}